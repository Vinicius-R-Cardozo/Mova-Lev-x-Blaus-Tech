# ─── Loja MOVA LEV (Next.js) ────────────────────────────────────
# Copie para .env.local. Só variáveis NEXT_PUBLIC_ vão para o navegador.

# URL pública da loja (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API Fastify (Render em produção).
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Supabase — apenas a chave pública (anon/publishable). A service role NUNCA entra aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mostra o botão "Entrar com Google" (ative o provedor no Supabase antes).
NEXT_PUBLIC_AUTH_GOOGLE=false

# Analytics — só carregam depois do consentimento no banner de cookies.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Dados da empresa (rodapé e páginas legais). Sem valor, aparecem entre colchetes.
NEXT_PUBLIC_CNPJ=
NEXT_PUBLIC_RAZAO_SOCIAL=
NEXT_PUBLIC_ENDERECO=
NEXT_PUBLIC_EMAIL_CONTATO=
NEXT_PUBLIC_EMAIL_DPO=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_HORARIO=segunda a sexta, das 9h às 18h

# Segredo compartilhado com a API (revalidação do cache após o admin).
REVALIDATE_SECRET=
