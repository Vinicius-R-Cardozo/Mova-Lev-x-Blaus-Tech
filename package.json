{
  "name": "movalev",
  "private": true,
  "description": "Loja virtual MOVA LEV — moda fitness feminina",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"npm run dev -w @movalev/api\" \"npm run dev -w @movalev/web\"",
    "dev:api": "npm run dev -w @movalev/api",
    "dev:web": "npm run dev -w @movalev/web",
    "build": "npm run build -w @movalev/api && npm run build -w @movalev/web",
    "test": "npm test -w @movalev/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:local": "npm run db:local -w @movalev/api",
    "db:migrate": "npm run db:migrate -w @movalev/api",
    "db:seed": "npm run db:seed -w @movalev/api",
    "db:reset": "npm run db:reset -w @movalev/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
