# ─── API MOVA LEV ───────────────────────────────────────────────
# Copie para .env e preencha. NUNCA commite o .env.

NODE_ENV=development
PORT=4000
# Origens liberadas no CORS, separadas por vírgula (localhost já é liberado em dev).
CORS_ORIGINS=https://movalev.com.br,https://www.movalev.com.br

# Postgres do Supabase.
# Local (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Produção: use a connection string do *pooler* (porta 6543, ?pgbouncer=true) em DATABASE_URL
# e a conexão direta/sessão (porta 5432) em DIRECT_URL — usada só pelas migrações.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (Project Settings → API). A service role key fica SÓ aqui, no back-end.
# Use a service_role LEGADA (JWT "eyJ..."): a chave nova sb_secret_ é recusada pelo Storage.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: segredo legado HS256. Sem ele a API valida o JWT pelas chaves públicas (JWKS) do projeto.
SUPABASE_JWT_SECRET=

# Bucket público com as fotos dos produtos.
STORAGE_BUCKET=produtos

# E-mails a promover para admin no seed (separados por vírgula).
ADMIN_EMAILS=

# Minutos que o estoque fica reservado num pedido aguardando pagamento (Pix/cartão).
ORDER_RESERVATION_MINUTES=60
# Sem Cron Job (plano free): a própria API roda a expiração a cada N minutos (0 = desligado).
EXPIRE_ORDERS_INTERVAL_MINUTES=0
# Boleto compensa em até 3 dias úteis.
BOLETO_RESERVATION_HOURS=72

# URL pública da loja (links nos e-mails).
SITE_URL=https://movalev.com.br

# E-mail transacional (Resend). Sem chave, os e-mails são gravados em api/.data/emails.
RESEND_API_KEY=
EMAIL_FROM="MOVA LEV <pedidos@movalev.com.br>"

# Caixa que recebe as mensagens do formulário de contato.
STORE_EMAIL=

# Webhook de teste do MockPaymentProvider (vazio = desativado). Use um segredo longo.
MOCK_WEBHOOK_SECRET=

# Revalidação do cache da loja após mudanças no admin (mesmo segredo em web/.env.local).
WEB_REVALIDATE_URL=https://movalev.com.br/api/revalidate
REVALIDATE_SECRET=
